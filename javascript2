// При загрузке проверяем start parameter
const startParam = TG.initDataUnsafe?.start_param;
if (startParam && startParam.startsWith('ref_')) {
    const referrerId = startParam.replace('ref_', '');
    if (!localStorage.getItem(`referred_${userId}`)) {
        // Увеличиваем счётчик рефералов у реферера (имитация)
        let refData = JSON.parse(localStorage.getItem(`ref_${referrerId}`) || '{"count":0}');
        refData.count++;
        localStorage.setItem(`ref_${referrerId}`, JSON.stringify(refData));
        localStorage.setItem(`referred_${userId}`, 'true');
    }
}
